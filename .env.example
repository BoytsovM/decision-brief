# docker compose reads .env automatically. Copy this file to .env if using LLM.
# The demo works without copying this file or entering any keys.
DECISION_BRIEF_PORT=8501
DECISION_BRIEF_NEWS_MODE=demo
# Gateway slug. A case display name such as GLM-5.3-Flash is also accepted.
DECISION_BRIEF_MODEL=z-ai/glm-5.3-flash
# Case gateway. Backup for Russian hosting: https://api.alfahack-gateway26.ru/v1
DECISION_BRIEF_BASE_URL=https://changellenge.up.railway.app/v1
DECISION_BRIEF_API_KEY=
# Container paths only. External files must also be mounted read-only.
DECISION_BRIEF_COMPANIES=
DECISION_BRIEF_PAYMENTS=
